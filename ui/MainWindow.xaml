<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartEmAll" Width="480" Height="500" Icon="/app.ico" WindowStyle="None" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource PanelEdge}">
    <Grid Margin="20,18,12,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel x:Name="HeaderBar" Background="Transparent" Margin="0,0,8,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="GearBtn" Style="{StaticResource RoundBtn}" Width="42" Height="42">
            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" Foreground="{DynamicResource Fg}"/></Button>
          <Button x:Name="CloseBtn" Style="{StaticResource RoundBtn}" Width="42" Height="42">
            <TextBlock x:Name="CloseGlyph" FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE70D;" Foreground="{DynamicResource Fg}"/></Button>
        </StackPanel>
        <Button x:Name="SortBtn" Style="{StaticResource PillBtn}" HorizontalAlignment="Left" Margin="4">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="SortText" Text="Personalized" Foreground="{DynamicResource Fg}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE70D;" Margin="10,2,0,0" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Popup x:Name="SortPop" PlacementTarget="{Binding ElementName=SortBtn}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <Border CornerRadius="14" BorderThickness="1" Padding="4" Margin="0,0,12,12" MinWidth="170"
                  Background="{DynamicResource PanelSolid}" BorderBrush="{DynamicResource PanelEdge}">
            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
            <StackPanel x:Name="SortItems"/>
          </Border>
        </Popup>
        <Popup x:Name="TileMenu" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <Border CornerRadius="14" BorderThickness="1" Padding="4" Margin="0,0,12,12" MinWidth="190"
                  Background="{DynamicResource PanelSolid}" BorderBrush="{DynamicResource PanelEdge}">
            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
            <StackPanel x:Name="TileItems"/>
          </Border>
        </Popup>
      </DockPanel>
      <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel x:Name="TilesPanel" HorizontalAlignment="Center" Margin="0,0,6,0"/>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
