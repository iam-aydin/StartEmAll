<Window x:Class="Launcher.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartEmAll settings" Width="800" Height="580" Icon="/app.ico" WindowStyle="None" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Background="{DynamicResource PanelTint}" BorderBrush="{DynamicResource PanelEdge}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="SHeader" Background="Transparent">
        <TextBlock Text="Settings" Foreground="{DynamicResource Fg}" FontSize="12" Margin="20,0,0,0" VerticalAlignment="Center"/>
        <Button x:Name="SClose" Style="{StaticResource RoundBtn}" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,8,0">
          <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" Foreground="{DynamicResource Fg}"/></Button>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="NavHost" Margin="14,6,10,14" VerticalAlignment="Top"><StackPanel x:Name="NavPanel"/></Grid>
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
          <StackPanel x:Name="PageHost" Margin="14,0,24,28"/>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
